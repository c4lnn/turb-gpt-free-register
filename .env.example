# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# 所有 WebUI 可编辑配置都使用 .env 覆盖 config/*.py 默认值。

# ---- WebUI 授权 ----
# WebUI 登录授权码；仅保存在 .env，避免出现在进程命令行中
WEBUI_AUTH_CODE=
RUNTIME_STORAGE_BACKEND=sqlite
# 可选：Session Cookie 签名密钥；留空时从固定授权码派生，修改授权码会使已有登录失效
WEBUI_SESSION_SECRET=


# ---- 功能开关 ----
# 启用 Codex OAuth: 注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=
# 启用 2FA(TOTP): 注册完成后自动设置动态口令（会多收一封 OTP 邮件）；失败仍保存账号并记录状态
ENABLE_2FA=
# 启用 Flow 触发: 注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ---- 人工节奏 ----
# 启用随机停顿: 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=
# 停顿倍率: 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=

# ---- 邮箱 / OTP ----
# 自动取邮箱+收码: True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=
# 手动注册邮箱: USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=
# 显示名称: 留空则自动生成英文名
REGISTER_NAME=
# OTP 最长等待(秒): 等待验证码邮件的最长秒数，超时判失败
OTP_MAX_WAIT=
# OTP 轮询间隔(秒): 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=
# 邮箱来源: 可填单个或多个，逗号分隔并按顺序兜底：outlook,generic_api,cloudflare_domain,cloudflare,remail
EMAIL_SOURCE=
# Outlook取件模式: auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=
# 仅 cloudflare_domain：Email Routing 转发域名，如 mydomain.com（与 EMAIL_SOURCE=cloudflare 无关）
EMAIL_DOMAIN=
# 仅 cloudflare_domain：接收 Email Routing 转发的 QQ 邮箱，如 123456@qq.com
QQ_EMAIL=
# 仅 cloudflare_domain：QQ 邮箱 IMAP 授权码（不写回 config/*.py）
QQ_IMAP_PASSWORD=
# QQ IMAP 单次网络操作超时（秒），防止 OTP 轮询永久阻塞
QQ_IMAP_TIMEOUT=15
# Cloudflare Worker 临时邮箱（EMAIL_SOURCE 含 cloudflare 时；与 cloudflare_domain/QQ IMAP 不同）
# Worker API 根地址，例如 https://mail.example.com（不要末尾多余路径）
CLOUDFLARE_API_BASE=
# 匿名可空；admin 模式填 ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# none / bearer / x-api-key / x-admin-auth / query-key；admin 推荐 x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Worker 全局密码，注入请求头 x-custom-auth；无则留空
CLOUDFLARE_CUSTOM_AUTH=
# 创建邮箱路径: 默认 /api/new_address；admin 创建常用 /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# 邮件列表路径: 默认 /api/mails
CLOUDFLARE_PATH_MESSAGES=
# 域名列表路径: 默认 /api/domains
CLOUDFLARE_PATH_DOMAINS=
# Token 路径: 默认 /api/token（fallback 预留）
CLOUDFLARE_PATH_TOKEN=
# 默认收信域名，逗号分隔，例如 mail.example.com；可留空由 Worker 决定
CLOUDFLARE_DEFAULT_DOMAINS=
# HTTP 请求超时秒数，默认 20
CLOUDFLARE_REQUEST_TIMEOUT=
# admin 创建时随机 local-part 长度，默认 10
CLOUDFLARE_NAME_LENGTH=
# 是否启用随机子域名；默认 false，关闭时仍创建 <local>@<默认域名>
CLOUDFLARE_RANDOM_SUBDOMAIN_ENABLED=
# 随机小写字母长度，默认 6，允许 1-32
CLOUDFLARE_RANDOM_SUBDOMAIN_LENGTH=
# 固定子域名后缀；启用后必填，例如 mail，最终域名为 abcdef-mail.example.com
CLOUDFLARE_RANDOM_SUBDOMAIN_SUFFIX=
# Remail 开放 API 文档：https://remail.aishop6.com/docs
# API 根地址；填写文档地址也可以，客户端会自动去掉 /docs
REMAIL_API_BASE=
# Remail 控制台生成的 rk- 开头 API Key
REMAIL_API_KEY=
# Remail 项目列表中的 projectId（用于 ChatGPT/OpenAI 验证码项目）
REMAIL_PROJECT_ID=2
# 下单邮箱后缀，默认 outlook.com
REMAIL_EMAIL_SUFFIX=
# code=短效接码；purchase=长效购买（可重复收件），默认 purchase
REMAIL_SERVICE_MODE=purchase
# private_first 或 public_only，默认 public_only
REMAIL_SUPPLY_POLICY=public_only
# 下单后等待 service token 补齐的最长秒数，默认 30
REMAIL_ORDER_WAIT_SECONDS=
# HTTP 请求超时秒数，默认 20
REMAIL_REQUEST_TIMEOUT=

# ---- 浏览器画像 ----
# 地区画像: 应与代理出口地区一致；可选 jp/cn/us/sg。当前本地代理实测为日本东京，推荐 jp
BROWSER_LOCALE_PROFILE=
# 按出口IP自动画像: 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=
# IP定位超时(秒): 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=

# ---- 代理池 ----
# 代理池(每行一个): 每行一个代理 URL，留空行会被忽略；为空则不使用代理
PROXY_POOL=
# 套餐查询网络模式: auto=专用代理优先并允许回退；proxy=专用代理优先且强制代理；direct=强制直连
PLAN_CHECK_PROXY_MODE=
# 套餐查询专用代理(每行一个): 留空时 auto/proxy 从代理池选择；可能包含认证信息
PLAN_CHECK_PROXY=
# 套餐查询上游代理: 填写后形成 本地代理 -> 上游代理 -> ChatGPT；留空则直接连接专用代理
PLAN_CHECK_UPSTREAM_PROXY=

# ---- Checkout Session 类型检测 ----
# 注册后自动检测：仅最终确认 free + 0 元 Plus 试用资格时触发；默认关闭
CHECKOUT_SESSION_AUTO_CHECK=
# 网络模式：proxy=必须使用下方专用代理；direct=显式直连；不使用 PROXY_POOL 自动回退
CHECKOUT_SESSION_PROXY_MODE=
# Checkout 专用代理：可能包含认证信息，仅保存在 .env，不复用 PROXY_POOL
CHECKOUT_SESSION_PROXY=
# 账单国家/货币：必须显式填写两位/三位大写 ASCII 代码，例如 DE/EUR
CHECKOUT_SESSION_BILLING_COUNTRY=
CHECKOUT_SESSION_BILLING_CURRENCY=
# 单次请求超时、最大尝试次数和递增重试间隔
CHECKOUT_SESSION_TIMEOUT=
CHECKOUT_SESSION_MAX_ATTEMPTS=
CHECKOUT_SESSION_RETRY_DELAY=
# 独立队列参数；worker/队列容量修改后需重启 WebUI
CHECKOUT_SESSION_WORKERS=
CHECKOUT_SESSION_QUEUE_LIMIT=
CHECKOUT_SESSION_MIN_INTERVAL=
CHECKOUT_SESSION_JITTER=

# ---- 提链 ----
# 提链服务提供方: legacy=现有 SSE 服务；masi=Masi Kakao Job API
EXTRACT_LINK_PROVIDER=
# 更新方式: sse=服务端事件流；poll=后端主动轮询远端 Job
EXTRACT_LINK_UPDATE_MODE=
# 所有提链请求共用的显式代理；支持 http/https/socks5/socks5h，留空不显式指定
EXTRACT_LINK_PROXY=
# 提链类型: pix / upi / kakao_pay / ideal
EXTRACT_LINK_TYPE=
# 旧 SSE 提链服务地址与 CDK
EXTRACT_LINK_API_BASE=
EXTRACT_LINK_CDK=
# Masi API 地址；Masi CDK 通过 WebUI 的 CDK 池导入，不在 .env 配置
MASI_KAKAO_API_BASE=
# 提链队列与请求参数
EXTRACT_LINK_WORKERS=
EXTRACT_LINK_QUEUE_LIMIT=
EXTRACT_LINK_REQUEST_TIMEOUT=
EXTRACT_LINK_EVENT_TIMEOUT=
EXTRACT_LINK_POLL_INTERVAL=
EXTRACT_LINK_POLL_MAX_ERRORS=
# Masi CDK 额度查询与选择参数
MASI_CDK_QUERY_MAX_ATTEMPTS=
MASI_CDK_QUERY_RETRY_DELAY=
MASI_CDK_SELECTION_TIMEOUT=
MASI_CDK_REFRESH_WORKERS=

# ---- CPA / Codex ----
# 授权地址来源: cpa=由 CPA 管理接口生成授权地址；local=旧版本地生成 PKCE 授权地址
CODEX_AUTH_URL_SOURCE=
# CPA 管理地址: 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=
# 管理密钥: 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
CPA_MANAGEMENT_KEY=
# CPA 超时(秒): 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=
# 保存CPA回执: CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ---- 接码平台 ----
# 接码通道: grizzly / smsbower / l / h；SMSBower 使用独立配置
SMS_PROVIDER=
# 国家代码: 传给接码平台的 country；GrizzlySMS 常用：美国=187；L/H 通道按本地后台配置填写
SMS_COUNTRY=
# 服务/项目代码: GrizzlySMS/L 作为 service；H 通道可复用为 projectId
SMS_SERVICE=
# 换号重试次数: 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=
# 单号等短信(秒): 单个号等待短信到达的最长秒数，超时则换号
SMS_CODE_WAIT=
# GrizzlySMS API密钥: 保存在 .env（SMS_API_KEY），不写回 config/*.py
SMS_API_KEY=

# SMSBower V1 handler API（独立于 GrizzlySMS）
SMSBOWER_API_BASE=https://smsbower.page/stubs/handler_api.php
# SMSBower API Key（机密；WebUI 仅显示已配置状态）
SMSBOWER_API_KEY=
# 通过 SMSBower getServicesList / getCountries 确认，不能复用其他平台代码
SMSBOWER_SERVICE=
SMSBOWER_COUNTRY=
# 可留空；两者同时填写时最低价格不能大于最高价格
SMSBOWER_MIN_PRICE=
SMSBOWER_MAX_PRICE=
# H API 地址: H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=
# H 授权码: 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
H_ADMIN_AUTH_CODE=
# H 号码前缀: H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=
# H 取号方式: reusable=优先复用号码；new=每次取新号（调用 /api/admin/h/take-phone）
H_PHONE_ACQUIRE_MODE=
# L API 地址: L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=
# L 授权码: 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
L_ADMIN_AUTH_CODE=
# L 号码前缀: L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=
